+package HTTP::Tinyish::LWP::UserAgent;
+our @ISA = qw(LWP::UserAgent);
+
+sub redirect_ok {
+    my($self, $new_request, $response) = @_;
+    if ($self->{tinyish_verify_SSL}
+        && lc($response->request->uri->scheme) eq 'https'
+        && lc($new_request->uri->scheme) ne 'https') {
+        return 0;
+    }
+    $self->SUPER::redirect_ok($new_request, $response);
+}
+
 1;
