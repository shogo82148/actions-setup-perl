     my $uri = $self->uri . $args->{package} . ($query ? "?$query" : "");
-    my $res = HTTP::Tinyish->new->get($uri);
+    my $res = HTTP::Tinyish->new(verify_SSL => 1)->get($uri);
     return unless $res->{success};
 
     my $dist_meta = eval { JSON::PP::decode_json($res->{content}) };
