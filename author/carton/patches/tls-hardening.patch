Additional TLS hardening on top of secure-by-default.patch.
- mask credentials in mirror URLs in the TLS error message (including an empty user name)
- verify certificates in the MetaCPAN and MetaDB index clients
- LWP backend: always verify the hostname when verify_SSL is set
- Curl backend: reject redirects from HTTPS to plain HTTP when verify_SSL is set

--- Menlo/CLI/Compat.pm
+++ Menlo/CLI/Compat.pm
@@ -2694,7 +2694,7 @@
             $invalid_cert = 1 if $reply->{content} =~ m{Can't connect.+?:443}mi;
         }
         if ( $invalid_cert ) {
-            die <<"DIE";
+            die $self->mask_uri_passwords(<<"DIE");
 TLS issue found while fetching $uri:\n
 $reply->{content}\n
 Please verify your certificates or force an HTTP-only request/mirror
@@ -2933,7 +2933,7 @@
 
 sub mask_uri_passwords {
     my($self, @strings) = @_;
-    s{ (https?://) ([^:/]+) : [^@/]+ @ }{$1$2:********@}gx for @strings;
+    s{ (https?://) ([^:/]*) : [^@/]+ @ }{$1$2:********@}gx for @strings;
     return @strings;
 }
 
